[user]
	name = vityasyyy
	email = argyavityasy1208@gmail.com
[includeIf "gitdir:~/work/"]
	# Work repos live under ~/work/ -> Xendit identity (see .config/git/config-work).
	path = ~/.config/git/config-work
[includeIf "gitdir:~/xendit/"]
	# Xendit repos live under ~/xendit/ -> same Xendit identity.
	path = ~/.config/git/config-work
[credential]
	helper = osxkeychain
[safe]
	# Shared Homebrew: /opt/homebrew and its taps may belong to another macOS
	# profile and be group-writable (multi-user brew). git's automatic
	# same-group rule rejects group-writable repos, so opt in explicitly.
	# The taps glob covers every tap without a per-tap edit; these entries are
	# no-ops for a profile that owns the paths itself.
	directory = /opt/homebrew
	directory = /opt/homebrew/Library/Taps/*
[http]
	version = HTTP/1.1
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
