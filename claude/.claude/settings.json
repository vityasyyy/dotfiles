{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/sops/**)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ],
    "additionalDirectories": [
      "/tmp",
      "~/.local/bin"
    ]
  },
  "theme": "auto"
}
