#!/usr/bin/env bash
# herd — thin CLI over herdr for the lead-agent orchestration workflow.
# Canonical copy: ~/dotfiles/opencode/.local/bin/herd
set -euo pipefail

HERDR="${HERDR:-herdr}"

usage() {
  cat <<'EOF'
herd — thin CLI over herdr for the lead-agent orchestration workflow

Usage:
  herd status                     List agents and sessions
  herd spawn <name> [cwd]         Create or group a worker workspace and start an opencode agent
  herd prompt <name> <task>       Prompt an agent and wait for it to settle
  herd wait <name> [--until S]    Wait for an agent state (default: settled idle/done/blocked)
  herd read <name> [--lines N]    Read an agent's recent output
  herd attach <name>              Attach directly to an agent (detach: ctrl+b q)
  herd worktree <branch> [cwd]    Create a git worktree workspace for parallel work
EOF
}

json_get() {
  python3 -c "import json,sys; d=json.load(sys.stdin); print($1)"
}

cmd_status() {
  "$HERDR" agent list
  echo
  "$HERDR" session list
}

cmd_spawn() {
  local name="${1:-}"
  local cwd="${2:-$PWD}"
  [ -n "$name" ] || { echo "usage: herd spawn <name> [cwd]" >&2; exit 2; }
  cwd="$(cd "$cwd" && pwd -P)"

  local parent_ws="${HERDR_WORKSPACE_ID:-}"
  [ -n "$parent_ws" ] || { echo "herd spawn: must run inside a Herdr workspace" >&2; exit 1; }
  local parent_label
  parent_label="$("$HERDR" workspace get "$parent_ws" | json_get "d['result']['workspace']['label']")"
  [ -n "$parent_label" ] || parent_label="$parent_ws"

  local worktree_list worktree_path ws pane created_ws
  worktree_path=""
  if worktree_list="$("$HERDR" worktree list --workspace "$parent_ws" 2>/dev/null)"; then
    worktree_path="$(printf '%s' "$worktree_list" | python3 -c '
import json, sys
target = sys.argv[1]
for worktree in json.load(sys.stdin).get("result", {}).get("worktrees", []):
    if worktree.get("path") == target and worktree.get("is_linked_worktree") is True:
        print(target)
        break
' "$cwd")"
  fi

  local workspace_out
  if [ -n "$worktree_path" ]; then
    workspace_out="$("$HERDR" worktree open --workspace "$parent_ws" --path "$cwd" --label "$name" --no-focus)"
    created_ws="$(printf '%s' "$workspace_out" | json_get "0 if d['result']['already_open'] else 1")"
  else
    workspace_out="$("$HERDR" workspace create --cwd "$cwd" --label "$parent_label/$name" --no-focus)"
    created_ws=1
  fi
  ws="$(printf '%s' "$workspace_out" | json_get "d['result']['workspace']['workspace_id']")"
  pane="$(printf '%s' "$workspace_out" | json_get "d['result']['root_pane']['pane_id']")"
  if [ -z "$ws" ] || [ -z "$pane" ]; then
    echo "herd spawn: workspace creation did not return a workspace and root pane" >&2
    exit 1
  fi

  if ! command -v opencode >/dev/null 2>&1; then
    echo "herd spawn: opencode is not on PATH" >&2
    if [ "$created_ws" -eq 1 ]; then
      "$HERDR" workspace close "$ws" >/dev/null 2>&1 || true
    fi
    exit 1
  fi

  if ! opencode api get /api/agent 2>/dev/null | grep -Eq '"id"[[:space:]]*:[[:space:]]*"worker"'; then
    echo "herd spawn: worker agent is not installed; run ./install.sh" >&2
    if [ "$created_ws" -eq 1 ]; then
      "$HERDR" workspace close "$ws" >/dev/null 2>&1 || true
    fi
    exit 1
  fi

  local session_id="" session_payload
  cleanup_session() {
    if [ -n "${HERD_SESSION_ID:-}" ]; then
      opencode api delete "/api/session/$HERD_SESSION_ID" >/dev/null 2>&1 || true
      HERD_SESSION_ID=""
    fi
  }
  trap cleanup_session EXIT INT TERM
  session_payload="$(python3 -c 'import json,sys; print(json.dumps({"agent":"worker","title":sys.argv[1],"location":{"directory":sys.argv[2]}}))' "$name" "$cwd")"
  session_id="$(opencode api post /api/session --data "$session_payload" 2>/dev/null \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)["data"]["id"])' 2>/dev/null || true)"
  if [ -z "$session_id" ]; then
    echo "herd spawn: could not create a worker session; is the OpenCode service available?" >&2
    if [ "$created_ws" -eq 1 ]; then
      "$HERDR" workspace close "$ws" >/dev/null 2>&1 || true
    fi
    exit 1
  fi
  HERD_SESSION_ID="$session_id"

  local attempt out rc
  for attempt in 1 2 3 4 5; do
    out="$("$HERDR" agent start "$name" --kind opencode --pane "$pane" -- --session "$session_id" 2>&1)" && rc=0 || rc=$?
    if [ "$rc" -eq 0 ]; then
      HERD_SESSION_ID=""
      trap - EXIT INT TERM
      return 0
    fi
    if printf '%s' "$out" | grep -q '"code":"agent_name_taken"' && printf '%s' "$out" | grep -qi 'status=Idle'; then
      echo "herd spawn: agent '$name' already running (idle); treating as success" >&2
      cleanup_session
      trap - EXIT INT TERM
      return 0
    fi
    if [ "$attempt" -lt 5 ]; then
      echo "herd spawn: agent start failed (attempt $attempt/5), retrying..." >&2
      sleep 1
    fi
  done

  echo "herd spawn: failed to start agent '$name' after 5 attempts" >&2
  echo "$out" >&2
  cleanup_session
  trap - EXIT INT TERM
  if [ "$created_ws" -eq 1 ] && ! "$HERDR" agent get "$name" >/dev/null 2>&1; then
    "$HERDR" workspace close "$ws" >/dev/null 2>&1 || true
  fi
  exit 1
}

cmd_prompt() {
  local name="${1:-}"
  shift || true
  [ -n "$name" ] || { echo "usage: herd prompt <name> <task>" >&2; exit 2; }
  local task="$*"
  [ -n "$task" ] || { echo "usage: herd prompt <name> <task>" >&2; exit 2; }
  "$HERDR" agent prompt "$name" "$task" --wait --timeout 120000
}

cmd_wait() {
  local name="${1:-}"
  [ -n "$name" ] || { echo "usage: herd wait <name> [--until S]" >&2; exit 2; }
  shift
  if [ "${1:-}" = "--until" ]; then
    "$HERDR" agent wait "$name" --until "${2:?--until requires a state}" --timeout 120000
  else
    "$HERDR" agent wait "$name" --timeout 120000
  fi
}

cmd_read() {
  local name="${1:-}"
  [ -n "$name" ] || { echo "usage: herd read <name> [--lines N]" >&2; exit 2; }
  shift
  local lines=120
  if [ "${1:-}" = "--lines" ]; then
    lines="${2:?--lines requires a number}"
  fi
  "$HERDR" agent read "$name" --source recent-unwrapped --lines "$lines"
}

cmd_attach() {
  local name="${1:-}"
  [ -n "$name" ] || { echo "usage: herd attach <name>" >&2; exit 2; }
  "$HERDR" agent attach "$name"
}

cmd_worktree() {
  local branch="${1:-}"
  local cwd="${2:-$PWD}"
  [ -n "$branch" ] || { echo "usage: herd worktree <branch> [cwd]" >&2; exit 2; }
  cwd="$(cd "$cwd" && pwd -P)"

  # Worktrees live inside the repo at <repo>/.worktrees/<branch> (gitignored),
  # NOT in ~/.herdr/worktrees — so all worker work stays inside the project.
  local repo_root
  repo_root="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$repo_root" ]; then
    local wt_path="$repo_root/.worktrees/$branch"
    mkdir -p "$repo_root/.worktrees"
    if [ -d "$wt_path" ]; then
      echo "herd worktree: $wt_path already exists; opening it" >&2
      "$HERDR" worktree open --cwd "$cwd" --path "$wt_path" --no-focus
    else
      "$HERDR" worktree create --cwd "$cwd" --branch "$branch" --path "$wt_path" --no-focus
    fi
  else
    "$HERDR" worktree create --cwd "$cwd" --branch "$branch"
  fi
}

case "${1:-}" in
  status)   shift; cmd_status "$@" ;;
  spawn)    shift; cmd_spawn "$@" ;;
  prompt)   shift; cmd_prompt "$@" ;;
  wait)     shift; cmd_wait "$@" ;;
  read)     shift; cmd_read "$@" ;;
  attach)   shift; cmd_attach "$@" ;;
  worktree) shift; cmd_worktree "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
