{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@slkiser/opencode-quota"
  ],
  "compaction": {
    "auto": false
  },
  "permissions": [
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.local/bin/**",
      "effect": "allow"
    }
  ],
  "providers": {
    "opencode-go": {}
  }
}
