{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-antigravity-auth@latest",
    "@slkiser/opencode-quota",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-pencil-sync"
  ],
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v2/mcp"
    },
    "figma": {
      "type": "remote",
