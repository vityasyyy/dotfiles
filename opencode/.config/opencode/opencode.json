        "clientId": "WIOaMeIVh0QpJStFlrBWyS",
        "clientSecret": "{env:FIGMA_MCP_CLIENT_SECRET}"
      }
    }
  },
  "lsp": true,
  "provider": {
    "google-antigravity": {},
    "opencode-go": {}
  }
}
