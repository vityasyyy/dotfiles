{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@slkiser/opencode-quota"
  ],
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp",
        "disabled": false
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      }
    }
  },
  "permissions": [
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.local/bin/**",
      "effect": "allow"
    }
  ],
  "providers": {
    "opencode-go": {}
  }
}
